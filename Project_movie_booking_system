# Movie Ticket Booking Registration System
# Core Python Project


bookings = []


# Available Movies
movies = {
    1: {"name": "Avengers Endgame", "time": "6 PM", "price": 250},
    2: {"name": "3 Idiots", "time": "3 PM", "price": 150},
    3: {"name": "Dangal", "time": "9 PM", "price": 200},
    4: {"name": "Interstellar", "time": "7 PM", "price": 300}
}


# Register Customer
def register_customer():

    print("\n--- Customer Registration ---")

    name = input("Enter Customer Name: ")
    phone = input("Enter Phone Number: ")

    customer = {
        "name": name,
        "phone": phone
    }

    print("Registration Successful!")

    return customer



# Display Movies
def display_movies():

    print("\n--- Available Movies ---")

    for key, movie in movies.items():

        print(
            key,
            ".",
            movie["name"],
            "| Time:",
            movie["time"],
            "| Price: ₹",
            movie["price"]
        )



# Book Ticket
def book_ticket():

    customer = register_customer()

    display_movies()

    try:

        choice = int(input("\nSelect Movie Number: "))

        if choice not in movies:
            print("Invalid movie selection")
            return


        movie = movies[choice]

        tickets = int(input("Enter Number of Tickets: "))


        total_amount = tickets * movie["price"]


        booking = {

            "customer_name": customer["name"],
            "phone": customer["phone"],
            "movie": movie["name"],
            "time": movie["time"],
            "tickets": tickets,
            "amount": total_amount

        }


        bookings.append(booking)


        print("\n----- Booking Confirmed -----")
        print("Customer:", customer["name"])
        print("Movie:", movie["name"])
        print("Show Time:", movie["time"])
        print("Tickets:", tickets)
        print("Total Amount: ₹", total_amount)


    except ValueError:

        print("Please enter valid input")



# View All Bookings
def view_bookings():

    print("\n--- Booking History ---")


    if len(bookings) == 0:

        print("No bookings available")

    else:

        for booking in bookings:

            print("----------------------")

            for key, value in booking.items():

                print(key, ":", value)



# Search Booking
def search_booking():

    name = input("Enter customer name: ")

    found = False


    for booking in bookings:

        if booking["customer_name"].lower() == name.lower():

            print("\nBooking Found")

            for key, value in booking.items():

                print(key, ":", value)

            found = True


    if found == False:

        print("Booking not found")



# Cancel Booking
def cancel_booking():

    name = input("Enter customer name to cancel booking: ")

    for booking in bookings:

        if booking["customer_name"].lower() == name.lower():

            bookings.remove(booking)

            print("Booking cancelled successfully")

            return


    print("Booking not found")



# Save Data To File
def save_file():

    file = open("bookings.txt", "w")


    for booking in bookings:

        file.write(str(booking))
        file.write("\n")


    file.close()


    print("Booking data saved successfully")



# Main Program

while True:


    print("\n==============================")
    print(" MOVIE TICKET BOOKING SYSTEM ")
    print("==============================")

    print("1. Book Ticket")
    print("2. Display Movies")
    print("3. View Bookings")
    print("4. Search Booking")
    print("5. Cancel Booking")
    print("6. Save Booking Data")
    print("7. Exit")


    try:

        choice = int(input("Enter Your Choice: "))


        if choice == 1:

            book_ticket()


        elif choice == 2:

            display_movies()


        elif choice == 3:

            view_bookings()


        elif choice == 4:

            search_booking()


        elif choice == 5:

            cancel_booking()


        elif choice == 6:

            save_file()


        elif choice == 7:

            print("Thank You For Using Movie Booking System")
            break


        else:

            print("Invalid Choice")


    except ValueError:

        print("Enter numbers only")
